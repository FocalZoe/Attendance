# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional Custom Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 初始系統總管安全預置 (SysAdmin Initial Bootstrap)
# 於首次部署或伺服器啟動時安全注入，不在前端暴露公開註冊
INITIAL_ADMIN_EMAIL=sysadmin@attendance.edu.tw
INITIAL_ADMIN_PASSWORD=your-secure-admin-password
INITIAL_ADMIN_NAME=平台系統總管

# ==============================================================================
# Attendance 前端與 Vercel Serverless 環境變數設定範本 (.env.example)
# 使用方式：複製此檔案為 .env 並填入您的真實金鑰與連線端點
# ==============================================================================

# Supabase 資料庫與儲存相簿設定 (必填)
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# API 與 WebSocket 連線設定 (選填)
VITE_API_BASE_URL=
VITE_WS_URL=
PORT=5000

# ==============================================================================
# 班級自動化點名系統 - 環境變數設定範本 (.env.example)
# 使用方式：複製此檔案為 .env 並填入您的 Supabase 真實金鑰
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 後端 API 與 Serverless 專用 (最高特權金鑰，嚴格禁止外洩至瀏覽器)
# ------------------------------------------------------------------------------
# 專案網址 (Project URL)
SUPABASE_URL=https://your-supabase-project-id.supabase.co

# 最新版 Secret key (以 sb_secret_ 開頭，具備特權存取)
SUPABASE_SECRET_KEY=sb_secret_your-secret-key-here

# (向下相容舊版 Legacy service_role key，若使用舊版金鑰可填寫此欄位)
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 2. 前端 Vite 專用 (僅具備 RLS 受控公開權限，可安全在瀏覽器環境使用)
# ------------------------------------------------------------------------------
# 前端專案網址 (與 SUPABASE_URL 相同)
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co

# 最新版 Publishable key (以 sb_publishable_ 開頭，安全公開金鑰)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key-here

# (向下相容舊版 Legacy anon key，若使用舊版金鑰可填寫此欄位)
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 3. 管理者管理頁面登入憑證 (選填，未設定時系統預設帳密為 admin / admin)
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ------------------------------------------------------------------------------
# 4. API 與 WebSocket 連線設定 (選填)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=
VITE_WS_URL=
PORT=5000

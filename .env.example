# Supabase Configuration (Vite SPA 前端環境變數)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 後端/腳本初始化專用（禁止放入前端程式碼；在 Vercel 設定時也不可加 VITE_ 前綴）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 平台系統總管 (SysAdmin Initial Bootstrap)
# 本機：npm run bootstrap:admin；Vercel：每次建置自動建立（帳號已存在就略過，不會重設密碼）
# 此帳號可永久刪除帳號、學校、班級、學生與點名照片，請使用強密碼
INITIAL_ADMIN_EMAIL=sysadmin@attendance.edu.tw
INITIAL_ADMIN_PASSWORD=your-secure-admin-password
INITIAL_ADMIN_NAME=平台系統總管

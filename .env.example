# 初始系統總管安全預置 (SysAdmin Initial Bootstrap)
INITIAL_ADMIN_EMAIL=sysadmin@attendance.edu.tw
INITIAL_ADMIN_PASSWORD=your-secure-admin-password
INITIAL_ADMIN_NAME=平台系統總管
